{
  "name": "sensor-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Web xem dang song accelerometer + gyroscope truc tiep tu Realtime Database",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/app.ts --bundle --format=iife --target=es2019 --minify --legal-comments=none --outfile=www/app.js",
    "build": "npm run typecheck && npm run bundle",
    "watch": "esbuild src/app.ts --bundle --format=iife --target=es2019 --sourcemap --outfile=www/app.js --watch",
    "serve": "npx --yes http-server www -p 5180 -c-1"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
