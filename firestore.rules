rules_version = '2';

// ============================================================
// firestore.rules — Luật bảo mật Cloud Firestore
// Đề tài: Cảnh báo té ngã tích hợp GPS (Fall Guard + Healthcare Map)
// ============================================================
//
// Nguyên tắc:
//   1. Không đăng nhập  →  không đọc/ghi được gì.
//   2. Chủ thiết bị (người có nguy cơ té ngã) toàn quyền với thiết bị của mình.
//   3. Người thân chỉ đọc được thiết bị mà CHỦ MÁY đã duyệt cho họ.
//   4. Ai cũng gửi được "yêu cầu ghép cặp", nhưng chỉ CHỦ MÁY mới duyệt được —
//      vì chỉ chủ máy biết mã OTP 6 số (mã này không nằm trên Firestore).
//
// Cách dán: Firebase Console → Firestore Database → tab Rules → xoá hết nội dung
// cũ → dán toàn bộ file này → bấm Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ------------------------------------------------------------
    // users/{userId} — hồ sơ tài khoản
    // ------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && uid() == userId;

      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.role in ['faller', 'guardian']
        && request.resource.data.email is string;

      // Cho phép tự sửa tên hiển thị / gắn deviceId, nhưng không đổi được email.
      allow update: if isSignedIn()
        && uid() == userId
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    // ------------------------------------------------------------
    // devices/{deviceId} — thiết bị của người có nguy cơ té ngã
    // deviceId chính là mã 12 chữ số hiển thị trong app Fall Guard
    // ------------------------------------------------------------
    match /devices/{deviceId} {

      function isOwner() {
        return isSignedIn() && resource.data.ownerUid == uid();
      }

      function isGuardian() {
        return isSignedIn() && uid() in resource.data.guardianUids;
      }

      // Người thân chỉ được phép TỰ GỠ CHÍNH MÌNH khỏi danh sách theo dõi,
      // không được đụng vào bất kỳ trường nào khác.
      // Phép so sánh tập hợp ở dòng cuối bảo đảm danh sách mới đúng bằng danh
      // sách cũ trừ đi chính mình — không bớt ai khác, cũng không thêm ai vào.
      function isSelfUnlink() {
        return isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardianUids'])
          && uid() in resource.data.guardianUids
          && !(uid() in request.resource.data.guardianUids)
          && request.resource.data.guardianUids.toSet()
             == resource.data.guardianUids.toSet().difference([uid()].toSet());
      }

      allow get, list: if isOwner() || isGuardian();

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.name is string
        && request.resource.data.guardianUids is list
        && request.resource.data.guardianUids.size() == 0;

      allow update: if isOwner() || isSelfUnlink();

      allow delete: if isOwner();

      // ----------------------------------------------------------
      // devices/{deviceId}/events/{eventId} — từng lần phát hiện té ngã
      // ----------------------------------------------------------
      match /events/{eventId} {

        function device() {
          return get(/databases/$(database)/documents/devices/$(deviceId)).data;
        }

        function isDeviceOwner() {
          return isSignedIn() && device().ownerUid == uid();
        }

        function canSeeDevice() {
          return isSignedIn()
            && (device().ownerUid == uid() || uid() in device().guardianUids);
        }

        allow read: if canSeeDevice();

        // Chỉ chủ máy mới được ghi sự kiện — người thân không thể dựng chuyện.
        allow create, update: if isDeviceOwner();

        // Cả hai bên đều được dọn lịch sử cũ.
        allow delete: if canSeeDevice();
      }

      // ----------------------------------------------------------
      // devices/{deviceId}/requests/{guardianUid} — yêu cầu ghép cặp
      // Tên tài liệu chính là uid của người thân gửi yêu cầu.
      // ----------------------------------------------------------
      match /requests/{guardianUid} {

        function isDeviceOwner() {
          return isSignedIn()
            && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == uid();
        }

        // Người thân chỉ đọc được yêu cầu CỦA CHÍNH MÌNH.
        allow read: if isSignedIn() && (uid() == guardianUid || isDeviceOwner());

        // Gửi / gửi lại yêu cầu: phải đúng uid của mình, thiết bị phải có thật,
        // và mã OTP phải đúng 6 ký tự.
        allow create, update: if isSignedIn()
          && uid() == guardianUid
          && exists(/databases/$(database)/documents/devices/$(deviceId))
          && request.resource.data.state == 'pending'
          && request.resource.data.guardianUid == uid()
          && request.resource.data.code is string
          && request.resource.data.code.size() == 6;

        // Chủ máy duyệt hoặc từ chối yêu cầu.
        allow update: if isDeviceOwner()
          && request.resource.data.state in ['approved', 'rejected'];

        allow delete: if isSignedIn() && (uid() == guardianUid || isDeviceOwner());
      }
    }

    // ------------------------------------------------------------
    // guardians/{guardianUid}/links/{deviceId}
    // Danh sách thiết bị mà một người thân đang theo dõi, kèm tên tự đặt.
    // Hoàn toàn riêng tư với từng tài khoản.
    // ------------------------------------------------------------
    match /guardians/{guardianUid}/links/{deviceId} {
      allow read, write: if isSignedIn() && uid() == guardianUid;
    }

    // ------------------------------------------------------------
    // Mọi đường dẫn khác đều bị chặn.
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
