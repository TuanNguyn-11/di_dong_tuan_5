// ============================================================
// database.rules.json — Luật bảo mật Realtime Database
// ============================================================
// Chỉ phục vụ chức năng xem dạng sóng cảm biến trực tiếp (sensor-viewer).
// Toàn bộ dữ liệu nghiệp vụ khác vẫn nằm ở Firestore với firestore.rules riêng.
//
// Cách dán: Firebase Console → Realtime Database → tab Rules → xoá hết nội dung
// cũ → dán toàn bộ file này → bấm Publish.
//
// Điểm cần nhớ: Realtime Database KHÔNG đọc được Firestore. Vì vậy danh sách
// người thân được app Fall Guard sao chép sang live/{deviceId}/meta/viewers.
// Chỉ chủ máy ghi được khối meta đó, nên người thân không thể tự thêm mình vào.

{
  "rules": {
    // Mặc định khoá sạch; chỉ mở đúng nhánh "live" bên dưới.
    ".read": false,
    ".write": false,

    "live": {
      "$deviceId": {
        // Đọc được nếu là chủ máy, hoặc có tên trong danh sách viewers.
        ".read": "auth != null && (data.child('meta/ownerUid').val() === auth.uid || data.child('meta/viewers').hasChild(auth.uid))",

        // Ghi được khi chưa ai nhận thiết bị này (lần đầu), hoặc mình đúng là chủ.
        // Dù trường hợp nào, sau khi ghi thì meta/ownerUid vẫn phải là chính mình
        // — nên không thể cướp luồng của người khác.
        ".write": "auth != null && (!data.child('meta/ownerUid').exists() || data.child('meta/ownerUid').val() === auth.uid) && newData.child('meta/ownerUid').val() === auth.uid",

        "meta": {
          "ownerUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "streaming": { ".validate": "newData.isBoolean()" },
          "hz": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 200" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "viewers": {
            "$uid": { ".validate": "newData.isBoolean()" }
          },
          "$other": { ".validate": false }
        },

        "chunks": {
          "$chunkId": {
            "t0": { ".validate": "newData.isNumber()" },
            "hz": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 200" },
            "ax": { ".validate": "newData.hasChildren()" },
            "ay": { ".validate": "newData.hasChildren()" },
            "az": { ".validate": "newData.hasChildren()" },
            "gx": { ".validate": "newData.hasChildren()" },
            "gy": { ".validate": "newData.hasChildren()" },
            "gz": { ".validate": "newData.hasChildren()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
